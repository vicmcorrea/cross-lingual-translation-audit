FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

COPY --from=ghcr.io/astral-sh/uv:0.9.28 /uv /uvx /bin/

ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_LINK_MODE=copy \
    HF_HOME=/workspace/cache/huggingface \
    TRANSFORMERS_CACHE=/workspace/cache/huggingface \
    TRANSLATION_AUDIT_DATA_ROOT=/dev/shm/translation-audit/plaintext/current/data \
    TRANSLATION_AUDIT_ARTIFACT_ROOT=/workspace \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install --yes --no-install-recommends age ca-certificates jq openssh-client rsync \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/translation-audit/experiments
COPY experiments/pyproject.toml experiments/uv.lock ./
RUN uv python install 3.14 && uv sync --frozen --no-install-project --extra gpu

COPY experiments/README.md ./README.md
COPY experiments/src ./src
COPY experiments/conf ./conf
RUN uv sync --frozen --extra gpu

COPY infrastructure/runpod/scripts /opt/translation-audit/runpod-scripts
RUN chmod 0755 /opt/translation-audit/runpod-scripts/*.sh \
    && install -m 0755 /opt/translation-audit/runpod-scripts/bootstrap_pod.sh /usr/local/bin/bootstrap-pod \
    && install -m 0644 /opt/translation-audit/runpod-scripts/verify_gpu.py /usr/local/bin/verify-gpu.py

ENTRYPOINT ["/usr/local/bin/bootstrap-pod"]
CMD ["uv", "run", "translation-audit", "runtime=runpod_secure", "runtime.execute=false"]
