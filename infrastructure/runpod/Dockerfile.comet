FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

COPY --from=ghcr.io/astral-sh/uv:0.9.28 /uv /uvx /bin/
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_LINK_MODE=copy \
    HF_HOME=/workspace/cache/huggingface \
    TRANSLATION_AUDIT_DATA_ROOT=/dev/shm/translation-audit/plaintext/current/data \
    TRANSLATION_AUDIT_ARTIFACT_ROOT=/workspace \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN apt-get update \
    && apt-get install --yes --no-install-recommends age ca-certificates jq \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/comet-runtime
COPY tools/comet/pyproject.toml tools/comet/uv.lock ./
RUN uv python install 3.11 && uv sync --frozen --no-dev
COPY infrastructure/runpod/scripts /opt/translation-audit/runpod-scripts
RUN chmod 0755 /opt/translation-audit/runpod-scripts/*.sh \
    && install -m 0755 /opt/translation-audit/runpod-scripts/bootstrap_tool_pod.sh /usr/local/bin/bootstrap-tool-pod
ENTRYPOINT ["/usr/local/bin/bootstrap-tool-pod"]
CMD ["uv", "run", "python", "-c", "import comet; print('COMET runtime ready')"]
